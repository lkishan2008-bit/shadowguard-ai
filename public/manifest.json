{
  "manifest_version": 3,
  "name": "ShadowGuard AI - Privacy DLP",
  "version": "1.0.0",
  "description": "Privacy-First AI Data Loss Prevention Engine",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"]
    }
  ]
}
