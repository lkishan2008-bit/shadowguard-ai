{
  "manifest_version": 3,
  "name": "ShadowGuard AI - Privacy DLP",
  "version": "1.0.0",
  "description": "Enterprise AI Security & Data Loss Prevention for LLMs",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.openai.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ]
}
